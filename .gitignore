# CRITICAL SECURITY: Never commit local sensitive dictionary or mapping logs!
config.json
*.local.json
*secret*
*.key
*.pem
*vault*.json
# Conventional private exports; arbitrary filenames still require user care.
*backup*.local.json
.aps-*.tmp

# Local investigation artifacts
work/

# Python virtual environment & bytecode
.venv/
venv/
ENV/
env/
